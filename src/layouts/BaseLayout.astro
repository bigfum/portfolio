---
import { ClientRouter } from "astro:transitions";
import "../styles/style.css";
const { title, description = "bigfum is a full-stack creative" } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0d0e15" />

        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/eurostile-mn.woff2"
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/eurostile.woff2"
            crossorigin
        />

        <ClientRouter />

        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "dark") {
                document.documentElement.setAttribute("data-theme", "dark");
            } else {
                document.documentElement.setAttribute("data-theme", "light");
            }

            const themeColorMeta = document.querySelector(
                'meta[name="theme-color"]',
            );
            if (themeColorMeta) {
                themeColorMeta.setAttribute(
                    "content",
                    theme === "dark" ? "#0d0e15" : "#ffffff",
                );
            }
        </script>
    </head>
    <body>
        <div
            class="safe-area-fill safe-area-fill-top"
            aria-hidden="true"
            transition:persist="safe-area-top"
        >
            <div class="safe-area-fill-inner"></div>
        </div>
        <div
            class="safe-area-fill safe-area-fill-bottom"
            aria-hidden="true"
            transition:persist="safe-area-bottom"
        >
            <div class="safe-area-fill-inner"></div>
        </div>
        <!-- persisted so navigating never rebuilds them mid-frame -->
        <div class="top-bar-blur" transition:persist="top-bar-blur">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="top-bar-blur bottom-bar-blur" transition:persist="bottom-bar-blur">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="menu-backdrop"></div>
        <header class="top-bar"></header>

        <nav class="sidebar">
            <h1>bigfum.dev</h1>

            <button
                id="hamburger-btn"
                class="hamburger-btn"
                aria-label="Toggle menu"
                aria-expanded="false"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

            <script>
                function setThemeColorMeta(theme: string) {
                    const color = theme === "dark" ? "#0d0e15" : "#ffffff";
                    const old = document.querySelector(
                        'meta[name="theme-color"]',
                    );
                    if (old) old.remove();
                    const fresh = document.createElement("meta");
                    fresh.setAttribute("name", "theme-color");
                    fresh.setAttribute("content", color);
                    document.head.appendChild(fresh);

                    document.body.style.transform = "translateZ(0)";
                    requestAnimationFrame(() => {
                        document.body.style.transform = "";
                    });

                    document
                        .querySelectorAll<HTMLElement>(".safe-area-fill")
                        .forEach((el) => {
                            el.style.transition = "none";
                            el.style.transform = "scaleY(0)";
                            void el.offsetHeight;
                            requestAnimationFrame(() => {
                                el.style.transform = "scaleY(1)";
                                requestAnimationFrame(() => {
                                    el.style.transition = "";
                                });
                            });
                        });
                }

                // after navigation: no repaint hacks here. the body transform in
                // setThemeColorMeta briefly unpins the fixed blur bars
                function applyTheme() {
                    // no saved choice: keep what the head script picked
                    const theme =
                        localStorage.getItem("theme") ||
                        document.documentElement.getAttribute("data-theme") ||
                        "light";
                    document.documentElement.setAttribute("data-theme", theme);
                    document
                        .querySelector('meta[name="theme-color"]')
                        ?.setAttribute(
                            "content",
                            theme === "dark" ? "#0d0e15" : "#ffffff",
                        );
                }

                let themeSwitchTimer: number | undefined;

                // see .theme-switching in style.css
                function fadeThemeChange() {
                    const root = document.documentElement;
                    const fade = getComputedStyle(root)
                        .getPropertyValue("--theme-fade")
                        .trim();
                    const ms = fade.endsWith("ms")
                        ? parseFloat(fade)
                        : parseFloat(fade) * 1000;
                    root.classList.add("theme-switching");
                    clearTimeout(themeSwitchTimer);
                    themeSwitchTimer = window.setTimeout(
                        () => root.classList.remove("theme-switching"),
                        ms + 50,
                    );
                }

                function setupThemeToggle() {
                    const toggleTheme = () => {
                        fadeThemeChange();
                        const isDark =
                            document.documentElement.getAttribute(
                                "data-theme",
                            ) === "dark";
                        const newTheme = isDark ? "light" : "dark";
                        document.documentElement.setAttribute(
                            "data-theme",
                            newTheme,
                        );
                        localStorage.setItem("theme", newTheme);
                        setThemeColorMeta(newTheme);
                    };

                    const buttons = document.querySelectorAll(
                        "#theme-toggle, #theme-toggle-mobile",
                    );
                    buttons.forEach((button) => {
                        button.removeEventListener("click", toggleTheme);
                        button.addEventListener("click", toggleTheme);
                    });
                }

                function setupHamburgerMenu() {
                    const hamburger = document.getElementById("hamburger-btn");
                    const navLinks = document.querySelector(".nav-links");
                    const backdrop = document.querySelector(".menu-backdrop");

                    if (!hamburger || !navLinks) {
                        return;
                    }

                    const toggleMenu = () => {
                        const isOpen = navLinks.classList.toggle("menu-open");
                        hamburger.classList.toggle("is-active", isOpen);
                        hamburger.setAttribute("aria-expanded", String(isOpen));
                        document.body.classList.toggle("menu-active", isOpen);
                    };

                    const closeMenu = () => {
                        navLinks.classList.remove("menu-open");
                        hamburger.classList.remove("is-active");
                        hamburger.setAttribute("aria-expanded", "false");
                        document.body.classList.remove("menu-active");
                    };

                    hamburger.addEventListener("click", toggleMenu);

                    if (backdrop) {
                        backdrop.addEventListener("click", closeMenu);
                    }
                }

                applyTheme();
                setupThemeToggle();
                setupHamburgerMenu();

                // the incoming page's <html> has no data-theme yet, so it would
                // render light for a moment. carry the current theme over
                document.addEventListener("astro:before-swap", (e) => {
                    const theme =
                        document.documentElement.getAttribute("data-theme");
                    if (theme) {
                        e.newDocument.documentElement.setAttribute(
                            "data-theme",
                            theme,
                        );
                    }
                });

                // clicking a link to the page you're on does nothing. capture
                // phase so it runs before astro's router, which skips
                // prevented clicks
                document.addEventListener(
                    "click",
                    (e) => {
                        const link = (e.target as Element).closest?.("a");
                        if (
                            !link ||
                            e.metaKey ||
                            e.ctrlKey ||
                            e.shiftKey ||
                            e.altKey ||
                            (link.target && link.target !== "_self")
                        ) {
                            return;
                        }
                        const url = new URL(link.href, location.href);
                        if (
                            url.origin === location.origin &&
                            url.pathname === location.pathname &&
                            url.search === location.search &&
                            !url.hash
                        ) {
                            e.preventDefault();
                            // still close the mobile menu if it's open
                            if (document.querySelector(".nav-links.menu-open")) {
                                document.getElementById("hamburger-btn")?.click();
                            }
                        }
                    },
                    { capture: true },
                );

                document.addEventListener("astro:after-swap", () => {
                    applyTheme();
                    setupThemeToggle();
                    setupHamburgerMenu();
                });
            </script>

            <div class="nav-links">
                <a
                    href="/"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname === "/" && "active",
                    ]}>home</a
                >
                <!-- <a
                    href="/projects"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname.startsWith("/projects") && "active",
                    ]}>projects</a
                > -->
                <!-- <a
                    href="/toys"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname.startsWith("/toys") && "active",
                    ]}>toys</a
                > -->
                <a
                    href="/contact"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname.startsWith("/contact") && "active",
                    ]}>contact</a
                >

                <button
                    id="theme-toggle"
                    class="theme-btn theme-btn-desktop"
                    aria-label="Toggle Dark Mode"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="moon-icon"
                    >
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                </button>

                <button
                    id="theme-toggle-mobile"
                    class="theme-btn-mobile"
                    style="cursor: pointer; border: none; background: none; padding: 0;"
                    aria-label="Toggle Dark Mode"
                >
                    <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="moon-icon"
                    >
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                </button>
            </div>
            <div class="profile-details" id="profile-details">
                <div class="profile-info">
                    <p class="profile-tagline">full-stack creative.</p>
                    <p class="profile-bio">cs + ctd @ cu boulder</p>
                    <!-- <a
                        class="profile-link"
                        href="https://website.com/"
                        target="_blank"
                        rel="noopener noreferrer">link</a
                    > -->
                </div>
                <div class="profile-avatar" aria-hidden="true"></div>
            </div>
        </nav>

        <main>
            <div class="content-wrapper">
                <!-- <span style="display: block; margin-bottom: 1.625em;"></span> -->
                <slot />
            </div>
        </main>

        <script type="importmap">
            {
                "imports": {
                    "three": "https://unpkg.com/three@0.171.0/build/three.module.js",
                    "three/webgpu": "https://unpkg.com/three@0.171.0/build/three.webgpu.js",
                    "three/tsl": "https://unpkg.com/three@0.171.0/build/three.tsl.js"
                }
            }
        </script>

        <script type="module" src="/app.js"></script>

        <svg
            style="height: 0; width: 0; position: absolute; visibility: hidden;"
        >
        </svg>

        <canvas id="bg-canvas" transition:persist
        ></canvas>
    </body>
</html>
