---
import { ClientRouter } from "astro:transitions";
import "../styles/style.css";
const {
    title,
    description = "bigfum — full-stack creative building interactive, visual, and slightly unhinged things on the web.",
} = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1.0, viewport-fit=cover"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0d0e15" />

        <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
        <link
            rel="preload"
            as="font"
            type="font/woff"
            href="https://fonts.cdnfonts.com/s/70817/Eurostile%20MN%20Extended%20Bold.woff"
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/woff"
            href="https://fonts.cdnfonts.com/s/13662/eurostile.woff"
            crossorigin
        />

        <ClientRouter />

        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "dark";
            })();

            if (theme === "dark") {
                document.documentElement.setAttribute("data-theme", "dark");
            } else {
                document.documentElement.setAttribute("data-theme", "light");
            }

            const themeColorMeta = document.querySelector(
                'meta[name="theme-color"]',
            );
            if (themeColorMeta) {
                themeColorMeta.setAttribute(
                    "content",
                    theme === "dark" ? "#0d0e15" : "#ffffff",
                );
            }
        </script>
    </head>
    <body>
        <div class="safe-area-fill safe-area-fill-top" aria-hidden="true">
            <div class="safe-area-fill-inner"></div>
        </div>
        <div class="safe-area-fill safe-area-fill-bottom" aria-hidden="true">
            <div class="safe-area-fill-inner"></div>
        </div>
        <div class="top-bar-blur">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="menu-backdrop"></div>
        <header class="top-bar"></header>

        <nav class="sidebar">
            <h1>bigfum.dev</h1>

            <button
                id="hamburger-btn"
                class="hamburger-btn"
                aria-label="Toggle menu"
                aria-expanded="false"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

            <script>
                function setThemeColorMeta(theme) {
                    const color = theme === "dark" ? "#0d0e15" : "#ffffff";
                    const old = document.querySelector(
                        'meta[name="theme-color"]',
                    );
                    if (old) old.remove();
                    const fresh = document.createElement("meta");
                    fresh.setAttribute("name", "theme-color");
                    fresh.setAttribute("content", color);
                    document.head.appendChild(fresh);

                    document.body.style.transform = "translateZ(0)";
                    requestAnimationFrame(() => {
                        document.body.style.transform = "";
                    });

                    document
                        .querySelectorAll(".safe-area-fill")
                        .forEach((el) => {
                            el.style.transition = "none";
                            el.style.transform = "scaleY(0)";
                            void el.offsetHeight;
                            requestAnimationFrame(() => {
                                el.style.transform = "scaleY(1)";
                                requestAnimationFrame(() => {
                                    el.style.transition = "";
                                });
                            });
                        });
                }

                function applyTheme() {
                    const theme = localStorage.getItem("theme") || "light";
                    document.documentElement.setAttribute("data-theme", theme);
                    setThemeColorMeta(theme);
                }

                function setupThemeToggle() {
                    const toggleTheme = () => {
                        const isDark =
                            document.documentElement.getAttribute(
                                "data-theme",
                            ) === "dark";
                        const newTheme = isDark ? "light" : "dark";
                        document.documentElement.setAttribute(
                            "data-theme",
                            newTheme,
                        );
                        localStorage.setItem("theme", newTheme);
                        setThemeColorMeta(newTheme);
                    };

                    const buttons = document.querySelectorAll(
                        "#theme-toggle, #theme-toggle-mobile",
                    );
                    buttons.forEach((button) => {
                        button.removeEventListener("click", toggleTheme);
                        button.addEventListener("click", toggleTheme);
                    });
                }

                function setupHamburgerMenu() {
                    const hamburger = document.getElementById("hamburger-btn");
                    const navLinks = document.querySelector(".nav-links");
                    const backdrop = document.querySelector(".menu-backdrop");

                    if (!hamburger || !navLinks) {
                        return;
                    }

                    const toggleMenu = () => {
                        const isOpen = navLinks.classList.toggle("menu-open");
                        hamburger.classList.toggle("is-active", isOpen);
                        hamburger.setAttribute("aria-expanded", String(isOpen));
                        document.body.classList.toggle("menu-active", isOpen);
                    };

                    const closeMenu = () => {
                        navLinks.classList.remove("menu-open");
                        hamburger.classList.remove("is-active");
                        hamburger.setAttribute("aria-expanded", "false");
                        document.body.classList.remove("menu-active");
                    };

                    hamburger.addEventListener("click", toggleMenu);

                    if (backdrop) {
                        backdrop.addEventListener("click", closeMenu);
                    }
                }

                function setupProfileSheet() {
                    const el = document.getElementById("profile-details");
                    if (!el) return;

                    if (window.__profileSheetCleanup) {
                        window.__profileSheetCleanup();
                        window.__profileSheetCleanup = null;
                    }

                    document.body.classList.remove("gesture-locked");

                    const isHome = window.location.pathname === "/";
                    const isMobile = window.matchMedia(
                        "(max-width: 1024px)",
                    ).matches;

                    if (!isHome || !isMobile) {
                        el.classList.remove("profile-sheet-active");
                        el.style.transform = "";
                        el.style.opacity = "";
                        return;
                    }

                    el.classList.add("profile-sheet-active");
                    document.body.classList.add("gesture-locked");

                    const reduceMotion = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches;

                    if (reduceMotion) {
                        el.style.transform = "translateY(0)";
                        el.style.opacity = "1";
                        return;
                    }

                    const revealDistance = 180;
                    let progressPx = 0;
                    let ticking = false;
                    let touchStartY = null;
                    let lastTouchY = null;
                    let lastTouchTime = 0;
                    let velocity = 0;
                    let momentumFrame = null;

                    const render = () => {
                        const progress = Math.min(
                            Math.max(progressPx / revealDistance, 0),
                            1,
                        );
                        el.style.transform = `translateY(${(1 - progress) * 100}%)`;
                        el.style.opacity = String(progress);
                        ticking = false;
                    };

                    const queueRender = () => {
                        if (!ticking) {
                            requestAnimationFrame(render);
                            ticking = true;
                        }
                    };

                    const applyDelta = (deltaY) => {
                        progressPx = Math.min(
                            Math.max(progressPx + deltaY, 0),
                            revealDistance,
                        );
                        queueRender();
                    };

                    const stopMomentum = () => {
                        if (momentumFrame !== null) {
                            cancelAnimationFrame(momentumFrame);
                            momentumFrame = null;
                        }
                    };

                    const runMomentum = () => {
                        velocity *= 0.94;
                        if (
                            Math.abs(velocity) < 0.02 ||
                            progressPx <= 0 ||
                            progressPx >= revealDistance
                        ) {
                            momentumFrame = null;
                            return;
                        }
                        applyDelta(velocity * 16);
                        momentumFrame = requestAnimationFrame(runMomentum);
                    };

                    const onWheel = (e) => {
                        e.preventDefault();
                        stopMomentum();
                        applyDelta(e.deltaY);
                    };

                    const onTouchStart = (e) => {
                        stopMomentum();
                        touchStartY = e.touches[0].clientY;
                        lastTouchY = touchStartY;
                        lastTouchTime = performance.now();
                        velocity = 0;
                    };

                    const onTouchMove = (e) => {
                        if (touchStartY === null) return;
                        const currentY = e.touches[0].clientY;
                        const now = performance.now();
                        const deltaY = lastTouchY - currentY;
                        const dt = Math.max(now - lastTouchTime, 1);
                        velocity = velocity * 0.7 + (deltaY / dt) * 0.3;
                        lastTouchY = currentY;
                        lastTouchTime = now;
                        e.preventDefault();
                        applyDelta(deltaY);
                    };

                    const onTouchEnd = () => {
                        touchStartY = null;
                        if (Math.abs(velocity) > 0.05) {
                            momentumFrame = requestAnimationFrame(runMomentum);
                        }
                    };

                    render();
                    window.addEventListener("wheel", onWheel, {
                        passive: false,
                    });
                    window.addEventListener("touchstart", onTouchStart, {
                        passive: true,
                    });
                    window.addEventListener("touchmove", onTouchMove, {
                        passive: false,
                    });
                    window.addEventListener("touchend", onTouchEnd);

                    window.__profileSheetCleanup = () => {
                        stopMomentum();
                        window.removeEventListener("wheel", onWheel);
                        window.removeEventListener("touchstart", onTouchStart);
                        window.removeEventListener("touchmove", onTouchMove);
                        window.removeEventListener("touchend", onTouchEnd);
                        document.body.classList.remove("gesture-locked");
                    };
                }

                applyTheme();
                setupThemeToggle();
                setupHamburgerMenu();
                setupProfileSheet();

                window
                    .matchMedia("(max-width: 1024px)")
                    .addEventListener("change", setupProfileSheet);

                document.addEventListener("astro:after-swap", () => {
                    applyTheme();
                    setupThemeToggle();
                    setupHamburgerMenu();
                    setupProfileSheet();
                });
            </script>

            <div class="nav-links">
                <a
                    href="/"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname === "/" && "active",
                    ]}>home</a
                >
                <!-- <a
                    href="/projects"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname.startsWith("/projects") && "active",
                    ]}>projects</a
                > -->
                <!-- <a
                    href="/toys"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname.startsWith("/toys") && "active",
                    ]}>toys</a
                > -->
                <a
                    href="/contact"
                    class:list={[
                        "nav-link",
                        Astro.url.pathname.startsWith("/contact") && "active",
                    ]}>contact</a
                >

                <button
                    id="theme-toggle"
                    class="theme-btn theme-btn-desktop"
                    aria-label="Toggle Dark Mode"
                >
                    <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="moon-icon"
                    >
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                </button>

                <button
                    id="theme-toggle-mobile"
                    class="theme-btn-mobile"
                    style="cursor: pointer; border: none; background: none; padding: 0;"
                    aria-label="Toggle Dark Mode"
                >
                    <svg
                        width="28"
                        height="28"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="moon-icon"
                    >
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                </button>
            </div>
            <div class="profile-details" id="profile-details">
                <div class="profile-info">
                    <p class="profile-tagline">full-stack creative.</p>
                    <p class="profile-bio">cs + ctd @ cu boulder</p>
                    <p class="profile-bio">
                        leading a rover team's software & always sweating the
                        visual details
                    </p>
                    <!-- <a
                        class="profile-link"
                        href="https://website.com/"
                        target="_blank"
                        rel="noopener noreferrer">link</a
                    > -->
                </div>
                <div class="profile-avatar" aria-hidden="true"></div>
            </div>
        </nav>

        <main>
            <div class="content-wrapper">
                <!-- <span style="display: block; margin-bottom: 1.625em;"></span> -->
                <slot />
            </div>
        </main>

        <script type="importmap">
            {
                "imports": {
                    "three": "https://unpkg.com/three@0.171.0/build/three.module.js",
                    "three/webgpu": "https://unpkg.com/three@0.171.0/build/three.webgpu.js",
                    "three/tsl": "https://unpkg.com/three@0.171.0/build/three.tsl.js"
                }
            }
        </script>

        <!-- <script type="module" src="/app.js"></script> -->

        <svg
            style="height: 0; width: 0; position: absolute; visibility: hidden;"
        >
        </svg>

        <canvas id="bg-canvas" transition:persist transition:animate="none"
        ></canvas>
    </body>
</html>
