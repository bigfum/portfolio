---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="bigfum // contact">
    <h2>secure contact gateway</h2>

    <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="contact-form"
    >
        <input
            type="hidden"
            name="access_key"
            value="ab398ca8-1bd3-45b7-b919-32e041c071eb"
        />

        <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none;"
        />

        <input
            type="hidden"
            name="subject"
            value="[bigfum.dev] New Transmission Received"
        />

        <input type="hidden" name="redirect" value="https://bigfum.dev/" />

        <div class="form-group">
            <label for="name">Identity / Name</label>
            <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g. Anonymous Dev"
            />
        </div>

        <div class="form-group">
            <label for="email">Return Path / Email</label>
            <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="name@domain.com"
            />
        </div>

        <div class="form-group">
            <label for="message">Transmission / Message</label>
            <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder="Type your message here..."></textarea>
        </div>

        <button type="submit" class="submit-btn"> Send &rarr; </button>
    </form>
</BaseLayout>
